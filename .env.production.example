# Runtime
NODE_ENV=production
PORT=8080
BASE_PATH=/

# PostgreSQL di VPS atau provider PostgreSQL pilihan Anda
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/jaseo

# Wajib diganti dengan random secret yang panjang
SESSION_SECRET=GANTI_DENGAN_SECRET_RANDOM_PANJANG

# Domain frontend yang diizinkan (gunakan https setelah domain aktif)
APP_ORIGIN=https://app.example.com
SESSION_COOKIE_SECURE=true

# Connector Google Sheets Replit tidak tersedia di VPS.
# Biarkan false sampai backup dipindahkan ke integrasi Google resmi.
ENABLE_GOOGLE_SHEETS_BACKUP=false

# Nilai ini masih memakai format path Object Storage Replit.
# Jangan mengaktifkan upload di VPS sebelum object storage dipindahkan
# ke provider S3-compatible atau implementasi filesystem yang aman.
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=